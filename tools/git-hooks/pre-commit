#!/bin/sh
# bob-kit pre-commit: validate skills, modes and hooks, then run the tests (hooks, cloud audit engine, security).
# Install once per clone:  git config core.hooksPath tools/git-hooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
python3 "$ROOT/tools/validate_kit.py"
python3 "$ROOT/tools/test_hooks.py"
python3 "$ROOT/tools/test_cloud_audit.py"
python3 "$ROOT/tools/test_security.py"
